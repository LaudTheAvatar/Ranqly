{
  "name": "ranqly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix backend --no-audit --no-fund || npm install --no-audit --no-fund --prefix backend",
    "prebuild": "node scripts/verify-next-tsconfig.cjs",
    "dev": "tsx server.ts",
    "dev:backend": "cd backend && npm run dev",
    "build": "next build",
    "ci": "npm run build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "dev:full": "concurrently -n web,api -c cyan,magenta \"npm run dev:next-only\" \"npm run dev:backend\"",
    "dev:next-only": "next dev",
    "tunnel": "npx --yes localtunnel --port ${PORT:-3000}"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@reown/appkit-siwe": "^1.8.19",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "ethers": "^6.13.0",
    "express": "^5.2.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "siwe": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "viem": "^2.47.4",
    "wagmi": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "utf-8-validate": "6.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
